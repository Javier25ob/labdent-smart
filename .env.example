# Copia este archivo como ".env" (sin .example) y rellena tus datos. El ".env" NO se sube a GitHub.

# --- Base de datos compartida (PostgreSQL / Supabase) ---
# Déjala vacía o bórrala para usar SQLite local (un archivo en tu computador).
# En Supabase: Project Settings > Database > Connection string > "Session pooler" (URI).
# Si tu contraseña tiene símbolos como @ : / # ? reemplázalos por su código (@ = %40, # = %23, etc.).
DATABASE_URL=postgresql://postgres.coolbdjkkgqkrapuvtqq:Modelamiento1@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# --- Clave secreta (firma las sesiones y los QR) ---
# TODO el equipo debe usar la MISMA clave, o los QR de uno no servirán en el PC de otro.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
LABDENT_SECRET_KEY= Modelamiento
